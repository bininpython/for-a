# ─── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave de serviço — NUNCA prefixar com NEXT_PUBLIC_, usada apenas no servidor
# (criação de contas de alunos pelo painel administrativo)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Aplicação ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail do personal trainer (recebe perfil com role=admin no primeiro login)
ADMIN_EMAIL=patrick@exemplo.com

# ─── Integrações opcionais (deixe vazio enquanto não configuradas) ─────────
# WhatsApp Cloud API — https://developers.facebook.com/docs/whatsapp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Resend — https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=
